{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start React",
            "type": "shell",
            "command": "npm.cmd start",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "react",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting the development server",
                    "endsPattern": "Compiled successfully"
                }
            }
        }
    ]
}